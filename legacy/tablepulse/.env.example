# Demo is explicitly enabled. Turn off before a live deployment.
TABLEPULSE_DEMO=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TABLEPULSE_VENUE_ID=11111111-1111-4111-8111-111111111111
# Use independently generated random secrets, at least 32 characters.
TABLEPULSE_TOKEN_SECRET=
TABLEPULSE_CUSTOMER_SECRET=
TABLEPULSE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Live customer SMS login is opt-in. Configure Supabase phone Auth + SMS + hCaptcha first.
TABLEPULSE_PHONE_LOGIN_ENABLED=false
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
# Optional constrained offer-ranking agent. Rules remain authoritative.
TABLEPULSE_AGENT_ENABLED=false
TABLEPULSE_AGENT_MODEL=gpt-6-astra
OPENAI_API_KEY=
