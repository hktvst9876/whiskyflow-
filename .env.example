# Return Anchor — environment. Copy to .env.local for development.
# Every variable is optional in development: `pnpm dev` runs an embedded Postgres (PGlite)
# with demo data and a demo WhatsApp inbox.

# ── Database ─────────────────────────────────────────────────────────────
# Postgres connection string for production (Supabase, Neon, RDS…). Run `pnpm db:migrate`
# on every deploy. When unset, an embedded PGlite database is used.
DATABASE_URL=
# Where the embedded database lives ("memory://" for a throwaway in-memory database).
PGLITE_DATA_DIR=.demo/pglite

# ── App ──────────────────────────────────────────────────────────────────
# Public base URL, used in QR codes and WhatsApp buttons.
APP_URL=http://127.0.0.1:3210
# 32+ random characters. REQUIRED in production. Rotating it invalidates claim and wallet links.
APP_SECRET=
# Demo merchants, demo accounts, time travel and the demo WhatsApp inbox. Defaults to on outside production.
DEMO_MODE=
# Seed the demo automatically on first start of an empty embedded database.
AUTO_SEED=
# Size of the simulated demo history.
DEMO_DAYS=35
DEMO_SCALE=0.5
# Shared secret for POST /api/cron/tick (send "Authorization: Bearer <secret>"). Schedule it every 5 minutes.
CRON_SECRET=

# ── WhatsApp ─────────────────────────────────────────────────────────────
# demo (messages appear in the console's demo phone) | console (stdout) | meta (WhatsApp Business Cloud API)
WHATSAPP_PROVIDER=demo
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Meta app secret: verifies X-Hub-Signature-256 on /api/webhooks/whatsapp.
WHATSAPP_APP_SECRET=
# Token you enter in Meta's webhook settings (GET verification).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANGUAGE=en

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
